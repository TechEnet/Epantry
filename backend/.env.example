NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/epantry

FRONTEND_URL=http://localhost:5173

ALLOW_SEED=false
SEED_SUPER_ADMIN_EMAIL=

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=EPANTRY/1.0

# Firebase Admin
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-admin-service-account.json

# Authentication Session
AUTH_SESSION_COOKIE_NAME=epantry_session
AUTH_CSRF_COOKIE_NAME=epantry_csrf
AUTH_SESSION_DAYS=5
AUTH_RECENT_SIGN_IN_SECONDS=300

# Session creation rate limit
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=900000
AUTH_SESSION_RATE_LIMIT_MAX=20

# Brevo Transactional Email
BREVO_API_KEY=
BREVO_SENDER_NAME=EPANTRY
BREVO_SENDER_EMAIL=

# Registration Email OTP
AUTH_EMAIL_OTP_LENGTH=6
AUTH_EMAIL_OTP_TTL_SECONDS=600
AUTH_EMAIL_OTP_MAX_ATTEMPTS=3
AUTH_EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_OTP_MAX_REQUESTS_PER_HOUR=5
AUTH_EMAIL_OTP_HMAC_SECRET=

# Registration proof after successful OTP
AUTH_REGISTRATION_PROOF_TTL_SECONDS=900

# OTP endpoint IP protection
AUTH_EMAIL_OTP_IP_RATE_LIMIT_WINDOW_MS=900000
AUTH_EMAIL_OTP_IP_RATE_LIMIT_MAX=30